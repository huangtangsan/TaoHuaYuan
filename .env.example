# 复制成 .env 再改：cp .env.example .env && chmod 600 .env
# .env 里都是密钥，不要提交到仓库、不要放进前端产物。

# ============ 必改 ============

# JWT 签名密钥：泄露等于任何人都能伪造管理员登录。
# 生成：openssl rand -hex 32
WEBSTACK_JWT_SECRET=replace-with-openssl-rand-hex-32

# 站点已经全站 HTTPS 后设为 1：登录 Cookie 只走 HTTPS，防止被明文回传。
# 本地 http://127.0.0.1 调试时设 0，否则浏览器不会保存 Cookie。
WEBSTACK_COOKIE_SECURE=1

# 生产环境建议 0，关闭 /api/docs 与 /api/openapi.json（等于把后台接口地图藏起来）
WEBSTACK_DOCS=0

# ============ 可选 ============

# 登录有效期（小时）
WEBSTACK_TOKEN_EXPIRE_HOURS=24

# 图标抓取：单个候选超时（秒）/ 单站点总预算（秒）
WEBSTACK_ICON_TIMEOUT=3
WEBSTACK_ICON_BUDGET=12

# 找不到图标时是否生成首字母占位图（0 则退回同一张默认图）
WEBSTACK_ICON_LETTER=1

# 镜像构建时使用的 PyPI 源（compose 会读这个变量传给 build arg）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
